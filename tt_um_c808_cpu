import cocotb
from cocotb.clock import Clock
from cocotb.triggers import ClockCycles


@cocotb.test()
async def test_c808_cpu(dut):
    clock = Clock(dut.clk, 40, units="ns")  # 25 MHz
    cocotb.start_soon(clock.start())

    # 1. Reset and verify built-in 8-bit Fibonacci up to 233
    dut.ena.value = 1
    dut.ui_in.value = 0
    dut.uio_in.value = 0  # prog_mode=0, prog_we=0
    dut.rst_n.value = 0
    await ClockCycles(dut.clk, 4)
    dut.rst_n.value = 1

    await ClockCycles(dut.clk, 300)
    assert int(dut.uo_out.value) == 233, f"Expected Fib max 233, got {int(dut.uo_out.value)}"
    assert (int(dut.uio_out.value) >> 7) & 1 == 1, "CPU should halt on 8-bit carry overflow"

    # 2. Reprogram RAM via prog_mode: read ui_in (100), add 15, output 115, halt
    program = [
        0xE1,  # 0: IN      (acc = ui_in)
        0x9F,  # 1: ADI 15  (acc = acc + 15)
        0xE0,  # 2: OUT     (uo_out = acc)
        0xF0,  # 3: HLT
    ]

    dut.uio_in.value = 0b01  # Enter prog_mode=1 (resets PC to 0)
    await ClockCycles(dut.clk, 1)

    for byte in program:
        dut.ui_in.value = byte
        dut.uio_in.value = 0b11  # prog_mode=1, prog_we=1
        await ClockCycles(dut.clk, 1)

    dut.uio_in.value = 0b00  # Exit prog_mode -> starts execution at PC=0
    dut.ui_in.value = 100
    await ClockCycles(dut.clk, 16)

    assert int(dut.uo_out.value) == 115, f"Expected 115, got {int(dut.uo_out.value)}"
